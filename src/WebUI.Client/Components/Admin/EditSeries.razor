@page "/admin/series-editor"
@page "/admin/series-editor/{id:int}"
@using WebUI.Client.Ports
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]

@inject ISeriesUIService SeriesUIService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="container mt-5">
    @if (series is null)
    {
        <MudProgressLinear Color="Color.Info"
                            Indeterminate="true"
                            Class="my-7" />
    }
    else
    {
        if (Editing)
        {
            <MudText Typo="Typo.h3">Edit series "@series.Name"</MudText>
        }
        else
        {
            <MudText Typo="Typo.h3">Create a new series</MudText>
        }

        <EditForm Model="series" OnValidSubmit="CreateOrUpdateSeriesAsync">
            <DataAnnotationsValidator />
            <div class="mb-3 mt-3 d-flex">
                <MudTextField T="string"
                              Label="Name"
                              Class="pr-2"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Name is required!"
                              @bind-Value="series.Name" />
                <MudTextField T="string"
                              Label="Description"
                              Class="pl-2"
                              Variant="Variant.Outlined"
                              @bind-Value="series.Description" />
            </div>
            <hr />
            <MudButton ButtonType="ButtonType.Submit"
                       Class="float-end mb-3 ml-2"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       Color="Color.Info">
                @(Editing ? "Update Series" : "Create Series")
            </MudButton>
            <ValidationSummary class="mb-3"></ValidationSummary>
        </EditForm>
        @if (Editing)
        {
            <MudButton Class="float-end"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Color="Color.Error"
                       @onclick="DeleteSeriesAsync">
                Delete Series
            </MudButton>
        }
    }
</div>
