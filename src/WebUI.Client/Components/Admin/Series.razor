@page "/admin/series"
@using WebUI.Client.Ports
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "Admin")]

@inject ISeriesUIService SeriesUIService
@inject NavigationManager NavigationManager

<div class="container mt-5">
    <MudText Typo="Typo.h3">Series</MudText>

    @if (SeriesUIService.Series is null)
    {
        <MudProgressLinear Color="Color.Info"
                           Indeterminate="true"
                           Class="my-7" />
    }
    else
    {
        <MudButton Variant="Variant.Filled"
                   Class="float-end mb-3"
                   StartIcon="@Icons.Material.Filled.Add"
                   Color="Color.Info"
                   @onclick="CreateSeries">Create new Series</MudButton>
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Number of Products</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <Virtualize Items="SeriesUIService.Series" Context="series">
                    <tr>
                        <td>@series.Name</td>
                        <td>@series.Description</td>
                        <td>@series.Products.Count</td>
                        <td>
                            <MudIconButton Variant="Variant.Filled"
                                           Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Info" aria-label="edit"
                                           OnClick="() => EditSeries(series.Id)"></MudIconButton>
                        </td>
                    </tr>
                </Virtualize>
            </tbody>
        </table>
    }
</div>
