@using WebUI.Client.Ports
@inject ISeriesUIService SeriesUIService
@implements IDisposable

<div class="mt-5">
    @if (SeriesUIService.Series is null || SeriesUIService.Series.Last().Products.Count == 0)
    {
        <center><h2>New Series Available Now</h2></center>
        <MudProgressLinear Color="Color.Info" Indeterminate="true" Class="my-7" />
    }
    else
    {
        <center><h2>@SeriesUIService.Series.Last().Name Available Now</h2></center>

        <div class="customContainer">
            @foreach (Product product in SeriesUIService.Series.Last().Products)
            {
                <div class="featured-product">
                    <div class="flex flex-center">
                        <a href="product/@product.Id">
                            <div class="media-img-wrapper">
                                <img src="@product.Images[0].Data" />
                            </div>
                        </a>
                    </div>
                    <h4>
                        <a href="product/@product.Id">@product.Title</a>
                    </h4>
                    @if (product.Variants is not null && product.Variants.Count > 0)
                    {
                        if (product.Variants.Count == 1)
                        {
                            <h5 class="price">
                                $@product.Variants[0].Price
                            </h5>
                        }
                        else
                        {
                            decimal lowestPrice = product.Variants.Min(v => v.Price);

                            <h5 class="price">
                                From $@lowestPrice
                            </h5>
                        }
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .customContainer {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        justify-content: center;
    }

    .media-img-wrapper {
        height: 250px;
        width: 170px;
        text-align: center;
        padding: 10px;
    }

    img {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        transition: transform 0.3s;
        object-fit: cover;
    }

    img:hover {
        transform: scale(1.1) rotate(2deg);
    }

    .featured-product {
        width: 200px;
        margin: 10px;
        text-align: center;
        padding: 10px;
        border: 1px solid lightgray;
        border-radius: 10px;
    }
</style>
